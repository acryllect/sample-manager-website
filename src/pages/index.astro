---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ShotWindow from "../components/ShotWindow.astro";
import Wave from "../components/Wave.astro";
import { site, links, text, applyHref, openPlaceholders } from "../config/site";
import { shots, tour } from "../data/shots";

const { productName } = site;

const open = openPlaceholders();
if (open.length) console.warn(`[placeholders] ${open.length} still open: ${[...new Set(open)].join(", ")}`);

// Each item comes from a recorded founder decision. Do not add others.
const next = [
  { title: "Smart collections", text: "Saved searches that keep themselves up to date." },
  { title: "Explore by sound", text: "A visual way to browse the sounds around the one you picked." },
  { title: "Projects", text: "Set a tempo and key, and audition sounds matched to them." },
  { title: "Automatic updates", text: "Updates arrive in the app. No more manual downloads." },
];
const included = [
  "Private access to the founding beta",
  "Direct onboarding and support from the founder",
  "Beta fixes and updates, delivered manually",
  "The v1 release, when it ships",
  "The founding price, regardless of the later public price",
];
const fit = [
  "You use an Apple-silicon Mac on macOS 14 or later.",
  "You produce music, compose, or design sound.",
  "Your library has 10,000+ samples, or has become hard to search.",
  "You'll test it on real work and give candid feedback.",
];
const steps = [
  "Apply with your Mac, library, and workflow details.",
  "If your setup fits, you get an invitation and the full terms.",
  "Pay €59 through hosted checkout.",
  "Get the notarized build and personal onboarding.",
  "Use it on real work and join short check-ins.",
];
---

<BaseLayout>
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="sl-container">
        <div class="sl-heading sl-heading--hero sl-heading--center">
          <h1 class="sl-heading__title" id="hero-title" data-rise style="--i:0">Find the sound. Skip the folders.</h1>
          <p class="sl-heading__lead" data-rise style="--i:1">
            {productName} turns scattered sample packs, folders, and drives into one searchable library for your Apple-silicon Mac, without uploading your sounds.
          </p>
        </div>
        <div class="sl-actions sl-actions--center" data-rise style="--i:2">
          <a class="sl-button sl-button--primary" href={applyHref("hero")}>Apply for an invitation</a>
          <a class="sl-button" href="#demo" data-demo-link>Watch the 75-second demo</a>
        </div>
        <p class="text-small hero__req" data-rise style="--i:3">Apple silicon · macOS 14 or later</p>
        <div class="hero__shot" data-rise-shot>
          <div class="halo" aria-hidden="true"></div>
          <ShotWindow shot={shots.S01} eager />
        </div>
      </div>
    </section>

    <!-- Search -->
    <section class="sl-section pain" aria-labelledby="pain-title">
      <div class="sl-container">
        <div class="sl-heading sl-heading--center section-intro" data-reveal>
          <h2 class="sl-heading__title" id="pain-title">Your library is bigger than your memory.</h2>
          <p class="sl-heading__lead">
            You remember the sound (dark, metallic, short) but not the pack, the filename, or the drive. So search for what you remember.
          </p>
        </div>
        <div data-reveal>
          <!-- The finished state is the markup. With motion allowed the script rewinds it and types it out once. -->
          <div class="sl-search sl-search--large search-demo" role="img" aria-label="Search field with the filters BPM 118 to 124 and Key A minor, followed by the text warm percussion" data-search-demo>
            <span class="search-demo__inner" aria-hidden="true">
              <img src="/assets/icons/search.svg" alt="" width="20" height="20" />
              <span class="sl-token" data-tok="bpm"><span class="sl-token__field">BPM</span><span class="sl-token__value">118–124</span></span>
              <span class="sl-token" data-tok="key"><span class="sl-token__field">Key</span><span class="sl-token__value">Amin</span></span>
              <span class="sl-search__text" data-typed>warm percussion</span>
              <span class="search-demo__caret" data-caret hidden></span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="sl-section tour" id="how-it-works" aria-labelledby="tour-title">
      <div class="sl-container">
        <div class="sl-heading sl-heading--center section-intro" data-reveal>
          <p class="sl-heading__eyebrow">How it works</p>
          <h2 class="sl-heading__title" id="tour-title">From remembered sound to usable result.</h2>
          <p class="sl-heading__lead">Six steps from a folder of packs to a sound in your project.</p>
        </div>

        <div class="tour__ui" data-tour data-reveal>
          <div class="tabs-row">
            <div class="tabs" role="tablist" aria-label="How it works" data-tabs>
              {
                tour.map((t, i) => (
                  <button type="button" role="tab" class="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                    {t.label}
                  </button>
                ))
              }
            </div>
            <button type="button" class="sl-button tour__pause" data-tour-pause aria-label="Pause the tour">Pause</button>
          </div>
          <div class="tour__stage">
            {
              tour.map((t, i) => (
                <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} class:list={["tour__panel", { "is-active": i === 0 }]}>
                  <figure class="sl-shot">
                    <ShotWindow shot={shots[t.shot]} />
                    <figcaption>{shots[t.shot].caption}</figcaption>
                  </figure>
                </div>
              ))
            }
          </div>
        </div>

        <figure class="sl-shot tour__video" id="demo" data-reveal>
          <div class="sl-shot__window">
            <video controls muted playsinline preload="none" poster={links.demoPoster} aria-label="The 75-second demo" data-demo>
              <source src={links.demoVideo} />
              <track kind="captions" src={links.demoCaptions} srclang="en" label="English" default />
            </video>
          </div>
        </figure>
      </div>
    </section>

    <!-- Today and next -->
    <section class="sl-section" id="beta-scope" aria-labelledby="scope-title">
      <div class="sl-container">
        <div class="sl-heading sl-heading--center section-intro" data-reveal>
          <h2 class="sl-heading__title" id="scope-title">What you get today and what comes next.</h2>
        </div>

        <!-- Every item must be verified against the exact paid-beta build before publication. -->
        <h3 class="label label--center" data-reveal>Today</h3>
        <ul class="cards" role="list">
          <li data-reveal style="--i:0">
            <div class="card">
              <div class="art art--icon">
                <span class="tile"><img src="/assets/icons/folder.svg" alt="" width="20" height="20" /></span>
                <span class="art__path">Samples / Field Recordings / Metal</span>
              </div>
              <div class="card__text">
                <h4 class="card__title">Indexed where they live</h4>
                <p class="card__desc">Reference mode reads your folders in place. Files are never moved.</p>
              </div>
            </div>
          </li>
          <li data-reveal style="--i:1">
            <div class="card">
              <div class="art">
                <div class="sl-tags">
                  <span class="sl-tag sl-tag--auto">One-shot</span>
                  <span class="sl-tag sl-tag--auto">Percussion</span>
                  <span class="sl-tag sl-tag--auto">Dark</span>
                  <span class="sl-tag sl-tag--auto">Metallic</span>
                </div>
              </div>
              <div class="card__text">
                <h4 class="card__title">Analysed on your Mac</h4>
                <p class="card__desc">BPM, key, type, and tags for every sound, with low-confidence values flagged.</p>
              </div>
            </div>
          </li>
          <li data-reveal style="--i:2">
            <div class="card">
              <div class="art">
                <div class="sl-search" role="img" aria-label="Search field with the filter Key A minor, followed by the text warm">
                  <img src="/assets/icons/search.svg" alt="" width="16" height="16" />
                  <span class="sl-token"><span class="sl-token__field">Key</span><span class="sl-token__value">Amin</span></span>
                  <span class="sl-search__text">warm</span>
                </div>
              </div>
              <div class="card__text">
                <h4 class="card__title">Search that forgives typos</h4>
                <p class="card__desc">Plain words, rough spellings, or exact filters like bpm:118-124.</p>
              </div>
            </div>
          </li>
          <li data-reveal style="--i:3">
            <div class="card">
              <div class="art art--stack">
                <span class="tile"><img src="/assets/icons/similar.svg" alt="" width="20" height="20" /></span>
                <div class="art__waves">
                  <Wave compact bars={30} seed={11} />
                  <Wave compact bars={30} seed={12} />
                  <Wave compact bars={30} seed={13} />
                </div>
              </div>
              <div class="card__text">
                <h4 class="card__title">Find similar</h4>
                <p class="card__desc">Pick a close sound and get its nearest neighbours from the whole library.</p>
              </div>
            </div>
          </li>
          <li data-reveal style="--i:0">
            <div class="card">
              <div class="art">
                <Wave bars={44} seed={21} played={17} sweep />
              </div>
              <div class="card__text">
                <h4 class="card__title">Level-matched auditioning</h4>
                <p class="card__desc">Optional loudness normalisation, so quiet sounds get a fair hearing.</p>
              </div>
            </div>
          </li>
          <li data-reveal style="--i:1">
            <div class="card">
              <div class="art">
                <div class="sl-tags">
                  <span class="sl-tag">Punchy</span>
                  <span class="sl-tag">Dark</span>
                  <span class="sl-tag">Layered</span>
                  <span class="sl-tag">Favourite</span>
                </div>
              </div>
              <div class="card__text">
                <h4 class="card__title">Crates, tags, and ratings</h4>
                <p class="card__desc">Collect finds, tag and rate them, and leave your folders alone.</p>
              </div>
            </div>
          </li>
          <li data-reveal style="--i:2">
            <div class="card">
              <div class="art art--icon">
                <span class="tile"><img src="/assets/icons/file.svg" alt="" width="20" height="20" /></span>
                <span class="art__path">Metal_Impact_03.wav</span>
              </div>
              <div class="card__text">
                <h4 class="card__title">WAV, AIFF, and FLAC export</h4>
                <p class="card__desc">Exports are new files. Your originals stay as they are.</p>
              </div>
            </div>
          </li>
        </ul>

        <h3 class="label label--center next__label" data-reveal>Next</h3>
        <ul class="next" role="list">
          {
            next.map((item, i) => (
              <li data-reveal style={`--i:${i}`}>
                <div class="next__item">
                  <span class="next__tag">Planned</span>
                  <h4 class="next__title">{item.title}</h4>
                  <p class="next__desc">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="next__note" data-reveal>Plans, not promises. What founding customers need most goes first.</p>

        <div class="not-beta" data-reveal>
          <h3 class="label label--center">Not in this beta</h3>
          <p class="not-beta__line">Public trial · licence activation · Intel Macs · DAW plug-in · cloud sync · Managed Library mode · MP3 export</p>
          <p class="not-beta__links">
            <a class="text-link" href={links.knownIssues}>Known issues</a>
            <a class="text-link" href={links.supportedSetup}>Supported setup</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="sl-section privacy" aria-labelledby="privacy-title">
      <div class="sl-container split">
        <div data-reveal>
          <div class="sl-heading">
            <h2 class="sl-heading__title" id="privacy-title">Your sample audio stays on your Mac.</h2>
            <p class="sl-heading__lead">
              {productName} indexes your files where they already live and analyses them on this Mac. No sample audio is uploaded. Keep your usual backup; {productName} can also back up and restore its own catalog of tags, ratings, crates, and analysis.
            </p>
          </div>
          <div class="sl-actions split__actions">
            <a class="sl-button" href={links.safetyGuide}>Read the safety guide</a>
          </div>
        </div>
        <figure class="sl-shot split__shot" data-reveal style="--i:1">
          <ShotWindow shot={shots.S09} />
          <figcaption>{shots.S09.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- Offer -->
    <section class="sl-section" id="offer" aria-labelledby="offer-title">
      <div class="sl-container">
        <div class="offer" data-reveal>
          <div class="offer__main">
            <p class="offer__price"><span class="offer__amount">€59</span><span class="offer__once">once</span></p>
            <h2 class="sl-heading__title" id="offer-title">Become a founding customer.</h2>
            <p class="offer__note">
              You're buying the app as it works today and a direct line to the person building it. Not a promise that every request gets built.
            </p>
            <div class="sl-actions">
              <a class="sl-button sl-button--primary" href={applyHref("offer")}>Apply for an invitation</a>
              <a class="sl-button" href={links.terms}>Review terms</a>
            </div>
          </div>
          <div class="offer__list">
            <h3 class="label">Included</h3>
            <ul>
              {included.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Who it's for and how joining works -->
    <section class="sl-section who" aria-labelledby="who-title">
      <div class="sl-container">
        <h2 class="sl-heading__title who__title" id="who-title" data-reveal>Apply if this sounds like your studio.</h2>
        <div class="who__cols">
          <div data-reveal>
            <h3 class="label">Who it's for</h3>
            <ul class="fit__list" role="list">{fit.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div data-reveal style="--i:1">
            <h3 class="label">How joining works</h3>
            <ol class="steps" role="list">{steps.map((step) => <li>{step}</li>)}</ol>
            <p class="steps__note">Applying doesn't commit you to buy.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sl-section" id="faq" aria-labelledby="faq-title">
      <div class="sl-container faq">
        <div class="sl-heading sl-heading--center section-intro" data-reveal>
          <h2 class="sl-heading__title" id="faq-title">FAQ</h2>
        </div>
        <div class="faq__list" data-reveal>
          <details>
            <summary><span>Why is the beta paid?</span><img src="/assets/icons/chevDown.svg" alt="" width="16" height="16" /></summary>
            <p>A small paid group means every setup gets personal support, and feedback comes from real use. Your €59 covers the beta, its updates, direct support, and the v1 release.</p>
          </details>
          <details>
            <summary><span>Is €59 a subscription?</span><img src="/assets/icons/chevDown.svg" alt="" width="16" height="16" /></summary>
            <p>No. It is a one-time founding-beta purchase under the published terms.</p>
          </details>
          <details>
            <summary><span>Will I need a licence key?</span><img src="/assets/icons/chevDown.svg" alt="" width="16" height="16" /></summary>
            <p>Not during the beta: access and builds come directly from the founder. When licensing arrives with the public release, founding customers get it at no extra cost.</p>
          </details>
          <details>
            <summary><span>How do updates work?</span><img src="/assets/icons/chevDown.svg" alt="" width="16" height="16" /></summary>
            <p>The founder sends each new notarized build with release notes and update steps. Automatic updates come after the beta.</p>
          </details>
          <details>
            <summary><span>Does it move my samples?</span><img src="/assets/icons/chevDown.svg" alt="" width="16" height="16" /></summary>
            <p>No. {productName} indexes your files where they already live.</p>
          </details>
          <details>
            <summary><span>What if it doesn't work for my setup?</span><img src="/assets/icons/chevDown.svg" alt="" width="16" height="16" /></summary>
            <p>
              Check the <a class="text-link" href={links.knownIssues}>known issues</a> and <a class="text-link" href={links.supportedSetup}>supported setup</a> before you pay, and read the <a class="text-link" href={links.terms}>refund terms</a>. If installation, library safety, or the core workflow is blocked, email {text.supportEmail} straight away.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="sl-section cta" id="apply" aria-labelledby="cta-title">
      <div class="sl-container">
        <div class="cta__inner" data-reveal>
          <div class="cta__icon">
            <span class="icon-halo" aria-hidden="true"></span>
            <img src="/assets/app-icon-160.png" srcset="/assets/app-icon-160.png 2x, /assets/app-icon-240.png 3x" alt="" width="80" height="80" />
          </div>
          <h2 class="sl-heading__title" id="cta-title">You already own the sound. Find it.</h2>
          <p class="cta__line">First cohort: about 10 places · {text.cohortStatus} · Next review {text.nextReviewDate}</p>
          <div class="sl-actions sl-actions--center">
            <a class="sl-button sl-button--primary" href={applyHref("closing")}>Apply for an invitation</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (function () {
      var root = document.documentElement;
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      var hasIO = "IntersectionObserver" in window;
      var each = function (list, fn) { Array.prototype.forEach.call(list, fn); };

      // If anything below throws, drop the motion class so nothing stays hidden.
      try {
        var motion = root.classList.contains("motion");

        // Scroll reveal: fade up once as an element enters. Items above the viewport (a reload
        // part-way down, an anchor jump) are shown at once.
        if (motion) {
          var reveals = document.querySelectorAll("[data-reveal]");
          if (!hasIO) {
            each(reveals, function (el) { el.classList.add("is-in"); });
          } else {
            var revealer = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting || e.boundingClientRect.top < 0) {
                  e.target.classList.add("is-in");
                  revealer.unobserve(e.target);
                }
              });
            }, { rootMargin: "0px 0px -8% 0px" });
            each(reveals, function (el) { revealer.observe(el); });
          }
        }

        // Animated search field: types bpm:118-124, key:Amin, then warm percussion, once.
        var field = document.querySelector("[data-search-demo]");
        var finishSearch = function () {};
        if (field && motion && hasIO) {
          var toks = { bpm: field.querySelector('[data-tok="bpm"]'), key: field.querySelector('[data-tok="key"]') };
          var typed = field.querySelector("[data-typed]");
          var caret = field.querySelector("[data-caret]");
          var steps = [["bpm:118-124 ", "bpm"], ["key:Amin ", "key"], ["warm percussion", null]];
          var finalText = typed.textContent;
          var timer = 0;
          var done = false;

          // Show the finished state, hold its height so typing never moves the page, then rewind to
          // empty. All in one task, so nothing paints in between.
          var rewind = function () {
            toks.bpm.hidden = false;
            toks.key.hidden = false;
            typed.textContent = finalText;
            typed.hidden = false;
            caret.hidden = true;
            field.style.minHeight = "";
            field.style.minHeight = getComputedStyle(field).height;
            toks.bpm.hidden = true;
            toks.key.hidden = true;
            typed.textContent = "";
            typed.hidden = true;
          };
          rewind();

          finishSearch = function () {
            clearTimeout(timer);
            done = true;
            toks.bpm.hidden = false;
            toks.key.hidden = false;
            typed.textContent = finalText;
            typed.hidden = false;
            caret.hidden = true;
            field.style.minHeight = "";
          };

          var type = function () {
            var si = 0;
            var ci = 0;
            rewind(); // fonts have loaded by now, so the held height is the real one
            caret.hidden = false;
            var tick = function () {
              if (done) return;
              var step = steps[si];
              ci++;
              var shown = step[0].slice(0, ci);
              if (ci === step[0].length && step[1]) {
                // The space converts the typed filter into its token.
                typed.textContent = "";
                typed.hidden = true;
                toks[step[1]].hidden = false;
                toks[step[1]].classList.add("is-new");
                si++;
                ci = 0;
                timer = setTimeout(tick, 160);
                return;
              }
              typed.textContent = shown;
              typed.hidden = false;
              if (ci === step[0].length) {
                // Finished: the caret blinks a few times and goes.
                caret.classList.add("is-blink");
                done = true;
                timer = setTimeout(function () { field.style.minHeight = ""; }, 4200);
                return;
              }
              timer = setTimeout(tick, 45);
            };
            tick();
          };

          if (hasIO) {
            var typer = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.intersectionRatio >= 0.5 && !done) {
                  typer.disconnect();
                  type();
                }
              });
            }, { threshold: [0, 0.5, 1] });
            typer.observe(field);
          }
        }

        // Audition card: the playhead sweeps only while the waveform is in view.
        var sweeps = document.querySelectorAll(".wave-sweep");
        if (motion && hasIO && sweeps.length) {
          var sweeper = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { e.target.classList.toggle("is-live", e.isIntersecting); });
          }, { threshold: 0.5 });
          each(sweeps, function (el) { sweeper.observe(el); });
        }

        // Tour: a tablist with arrow-key support (Left/Right wrap, Home/End) and a one-time
        // auto-advance that any click, key press or focus inside the tablist ends for good.
        var list = document.querySelector("[data-tabs]");
        var stopAuto = function () {};
        if (list) {
          var tabs = Array.prototype.slice.call(list.querySelectorAll('[role="tab"]'));
          var panels = tabs.map(function (t) { return document.getElementById(t.getAttribute("aria-controls")); });
          var select = function (tab, focus) {
            tabs.forEach(function (t, i) {
              var on = t === tab;
              t.setAttribute("aria-selected", String(on));
              t.tabIndex = on ? 0 : -1;
              panels[i].classList.toggle("is-active", on);
            });
            if (focus) tab.focus();
          };
          tabs.forEach(function (tab, i) {
            tab.addEventListener("click", function () { select(tab, false); });
            tab.addEventListener("keydown", function (e) {
              var next = { ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i + tabs.length - 1) % tabs.length, Home: 0, End: tabs.length - 1 }[e.key];
              if (next === undefined) return;
              e.preventDefault();
              select(tabs[next], true);
            });
          });

          var ui = document.querySelector("[data-tour]");
          var pause = document.querySelector("[data-tour-pause]");
          if (motion && hasIO && ui) {
            var auto = { started: false, stopped: false, userPaused: false, inView: false };
            var sync = function () {
              if (auto.stopped) { list.removeAttribute("data-auto"); return; }
              if (!auto.started) return;
              list.setAttribute("data-auto", auto.inView && !auto.userPaused && !document.hidden ? "running" : "paused");
            };
            stopAuto = function () {
              if (auto.stopped) return;
              auto.stopped = true;
              sync();
              if (pause) {
                var hadFocus = document.activeElement === pause;
                pause.hidden = true;
                if (hadFocus) tabs.filter(function (t) { return t.tabIndex === 0; })[0].focus();
              }
            };
            // The progress bar on the active tab is a CSS animation; when it ends, move on.
            list.addEventListener("animationend", function (e) {
              if (e.animationName !== "tab-progress" || auto.stopped) return;
              var i = tabs.indexOf(e.target);
              if (i < 0) return;
              if (i < tabs.length - 1) select(tabs[i + 1], false);
              else stopAuto();
            });
            ["pointerdown", "click", "keydown", "focusin"].forEach(function (name) { list.addEventListener(name, stopAuto); });
            if (pause) {
              pause.addEventListener("click", function () {
                auto.userPaused = !auto.userPaused;
                pause.textContent = auto.userPaused ? "Play" : "Pause";
                pause.setAttribute("aria-label", auto.userPaused ? "Play the tour" : "Pause the tour");
                sync();
              });
            }
            document.addEventListener("visibilitychange", sync);
            new IntersectionObserver(function (entries) {
              var e = entries[entries.length - 1];
              auto.inView = e.intersectionRatio >= 0.5;
              if (auto.inView) auto.started = true;
              sync();
            }, { threshold: [0, 0.5, 1] }).observe(ui);
          }
        }

        // Reduced motion switched on mid-visit: show everything, stop everything.
        if (reduce.addEventListener) {
          reduce.addEventListener("change", function () {
            if (!reduce.matches) return;
            root.classList.remove("motion");
            stopAuto();
            finishSearch();
          });
        }
      } catch (err) {
        root.classList.remove("motion");
        if (window.console) console.error(err);
      }

      // "Watch the 75-second demo" jumps to the video and starts it muted.
      var link = document.querySelector("[data-demo-link]");
      var video = document.querySelector("[data-demo]");
      if (link && video) {
        link.addEventListener("click", function () {
          video.muted = true;
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        });
      }
    })();
  </script>
</BaseLayout>
