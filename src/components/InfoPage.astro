---
/** Shell for the placeholder pages the app links to (/support/, /privacy/). */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { site } from "../config/site";

interface Props {
  title: string;
  placeholder: string;
}
const { title, placeholder } = Astro.props;
---

<BaseLayout title={`${title} · ${site.productName}`} noindex>
  <Header />
  <main class="info sl-container">
    <h1 class="sl-heading__title">{title}</h1>
    <p class="info__placeholder">{placeholder}</p>
    <p><a class="sl-button" href="/">Back to {site.productName}</a></p>
  </main>
  <Footer />
</BaseLayout>
