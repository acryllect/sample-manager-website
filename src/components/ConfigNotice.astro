---
interface Props {
  title: string;
  /** Visual weight: 'pending' (amber, awaiting config) or 'legal' (awaiting approved copy) */
  kind?: "pending" | "legal";
}

const { title, kind = "pending" } = Astro.props;
---

<div class:list={["notice", kind]} role="note">
  <p class="notice-title">{title}</p>
  <div class="notice-body">
    <slot />
  </div>
</div>

<style>
  .notice {
    border: 1px dashed var(--border);
    border-left: 3px solid var(--accent-dim);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    background: var(--bg-elevated);
  }

  .notice.legal {
    border-left-color: var(--danger);
  }

  .notice-title {
    margin: 0 0 var(--space-2);
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }

  .notice-title::before {
    content: "⚠ ";
    color: var(--accent);
  }

  .notice.legal .notice-title::before {
    color: var(--danger);
  }

  .notice-body :global(p) {
    margin: 0;
    font-size: 0.9375rem;
  }

  .notice-body :global(p + p) {
    margin-top: var(--space-2);
  }
</style>
