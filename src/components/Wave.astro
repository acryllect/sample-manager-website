---
/** The app's waveform (design system Waveform). Bars come from a seeded generator so the shape is
 *  identical on every build. Decoration only, so it is hidden from assistive tech.
 *
 *  `sweep` is for the one waveform that plays back on the page. Its played part is a second copy of
 *  the bars in the playing colour, revealed by a clip that only moves with `transform`, so the
 *  sweep animates nothing but transform. The static state (no motion, no JavaScript) is the same
 *  overlay parked at bar `played`. */
interface Props {
  bars?: number;
  seed?: number;
  /** Number of bars before the playhead. Omit for none. */
  played?: number;
  compact?: boolean;
  sweep?: boolean;
}
const { bars = 48, seed = 1, played, compact = false, sweep = false } = Astro.props;

let s = seed * 9301 + 49297;
const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
const heights = Array.from({ length: bars }, (_, i) => {
  const envelope = 0.35 + 0.65 * Math.sin((Math.PI * (i + 0.5)) / bars);
  return Math.min(1, Math.max(0.12, envelope * (0.35 + 0.65 * rand()))).toFixed(2);
});

// Bar geometry from bundle.css: 8px padding, 3px bars, 2px gap. x = playhead offset from the left edge.
const at = (n: number) => 8 + n * 5 - 2;
---

{
  sweep ? (
    <div class="sl-wave wave-sweep" aria-hidden="true" style={`--x:${at(played ?? 0)}px;--x0:${at(0)}px;--x1:${at(bars)}px`}>
      {heights.map((h) => <i style={`--h:${h}`} />)}
      <div class="wave-sweep__layer">
        <div class="wave-sweep__clip">
          <div class="wave-sweep__bars">{heights.map((h) => <i style={`--h:${h}`} />)}</div>
        </div>
        <span class="wave-sweep__head" />
      </div>
    </div>
  ) : (
    <div class:list={["sl-wave", { "sl-wave--compact": compact }]} aria-hidden="true">
      {
        heights.map((h, i) => (
          <>
            {played !== undefined && i === played && <b />}
            <i class:list={{ "is-played": played !== undefined && i < played }} style={`--h:${h}`} />
          </>
        ))
      }
    </div>
  )
}
