---
import { siteConfig } from "../config/site";
---

<section class="hero">
  <div class="container-narrow hero-inner">
    <p class="eyebrow">Founding beta &middot; {siteConfig.foundingPrice} once</p>
    <h1>Find the sound you know you have.</h1>
    <p class="lede">
      I built {siteConfig.productName} for the point where a sample library
      gets too big to remember. It searches the sounds already on your Mac
      and drives, so you can describe what you're looking for, audition the
      results, find similar sounds, and get back to the session.
    </p>

    <div class="hero-actions">
      <a href="/apply" class="btn btn-primary">Apply for the beta</a>
      <a href="/demo" class="btn btn-secondary">Watch it work</a>
    </div>

    <p class="hero-trust">
      Native macOS &middot; Apple silicon &middot; No subscription &middot; No sample uploads
    </p>
    <p class="hero-requirements mono">
      {siteConfig.supportedMacOS} &middot; Reference Library mode
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
  }

  .hero-inner {
    text-align: center;
  }

  .hero h1 {
    max-width: 16ch;
    margin-inline: auto;
  }

  .hero .lede {
    margin-inline: auto;
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-block: var(--space-6);
  }

  .hero-trust {
    font-size: 0.9375rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .hero-requirements {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0;
  }
</style>
