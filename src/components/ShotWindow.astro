---
/**
 * ScreenshotFrame window. Shows the real capture when shot.src is set, otherwise a labelled
 * placeholder. Never a mock of the app.
 */
import type { Shot } from "../data/shots";

interface Props {
  shot: Shot;
  /** Hide until the gallery or a tab selects it. */
  hidden?: boolean;
  eager?: boolean;
}
const { shot, hidden = false, eager = false } = Astro.props;
---

<div class="sl-shot__window" data-window={shot.id} hidden={hidden}>
  {
    shot.src ? (
      <img src={shot.src} alt={shot.alt} loading={eager ? "eager" : "lazy"} decoding="async" width="1600" height="1000" />
    ) : (
      <div class="shot-ph" role="img" aria-label={`Placeholder for ${shot.id}. ${shot.alt}`}>
        <span class="shot-ph__id">{shot.id} · Placeholder</span>
        <span class="shot-ph__state">{shot.state}</span>
      </div>
    )
  }
</div>
