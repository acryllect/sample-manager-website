---
const fit = [
  "You use an Apple-silicon Mac on macOS 14 or later.",
  "You actively produce music, compose, or design sound.",
  "Your local library contains 10,000+ samples or has become genuinely difficult to retrieve from.",
  "You can test with real work, use Reference mode, and provide candid feedback.",
  "You understand that updates are manual during the founding beta.",
];

const notFit = [
  "You need Windows or an Intel Mac.",
  "You need Managed Library mode or a sample subscription.",
  "You're looking for a drum sequencer, not a library manager.",
  "You need a DAW plug-in before you'll try the product.",
  "You need team features or cloud sync.",
];
---

<section class="fit section" id="fit">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Fit</p>
      <h2>Apply if this sounds like your studio.</h2>
    </div>

    <div class="grid grid-2">
      <div class="fit-col fit-yes">
        <h3>Good fit</h3>
        <ul>
          {fit.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="fit-col fit-no">
        <h3>Not yet a fit</h3>
        <ul>
          {notFit.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fit-col {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .fit-yes {
    border-left: 3px solid var(--accent);
  }

  .fit-no {
    border-left: 3px solid var(--border);
  }

  .fit-col h3 {
    font-size: 1rem;
    margin-bottom: var(--space-4);
  }

  .fit-col ul {
    margin: 0;
    padding-left: 1.1em;
  }

  .fit-col li {
    font-size: 0.9375rem;
  }
</style>
