---
import { site, links } from "../config/site";
---

<footer class="footer">
  <div class="sl-container footer__inner">
    <p class="footer__brand">
      <img src="/assets/app-icon-72.png" alt="" width="24" height="24" />
      <span>© {site.year} {site.owner}</span>
    </p>
    <nav aria-label="Footer">
      <ul class="footer__links" role="list">
        <li><a href={links.knownIssues}>Known issues</a></li>
        <li><a href={links.supportedSetup}>Supported setup</a></li>
        <li><a href={links.safetyGuide}>Safety guide</a></li>
        <li><a href="/support/">Support</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href={links.terms}>Terms</a></li>
      </ul>
    </nav>
  </div>
</footer>
