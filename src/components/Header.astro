---
import { site, applyHref } from "../config/site";
const { productName } = site;
---

<header class="sl-nav">
  <div class="sl-nav__inner">
    <a class="sl-nav__brand" href="/">
      <img src="/assets/app-icon-96.png" alt="" width="32" height="32" />
      <span>{productName}</span>
    </a>
    <nav class="sl-nav__links" aria-label="Primary">
      <a href="/#how-it-works">How it works</a>
      <a href="/#beta-scope">Features</a>
      <a href="/#offer">Price</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <a class="sl-button sl-button--primary" href={applyHref("header")}>Apply for an invitation</a>
  </div>
</header>
