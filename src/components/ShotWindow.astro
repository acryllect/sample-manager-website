---
/**
 * ScreenshotFrame window. Shows the real capture once the shot is captured (data/shots.ts),
 * otherwise a labelled placeholder. Never a mock of the app. The capture is served by astro:assets
 * as AVIF and WebP with a JPEG fallback, at three widths. Only the hero shot passes `eager`; the
 * rest lazy-load.
 */
import { Picture } from "astro:assets";
import { shotImage, type Shot } from "../data/shots";

interface Props {
  shot: Shot;
  eager?: boolean;
}
const { shot, eager = false } = Astro.props;
const image = shotImage(shot);
---

<div class="sl-shot__window" data-window={shot.id}>
  {
    image ? (
      <Picture
        src={image}
        alt={shot.alt}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[720, 1200, 2400]}
        sizes="(max-width: 1200px) 100vw, 1200px"
        width={image.width}
        height={image.height}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
      />
    ) : (
      <div class="shot-ph" role="img" aria-label={`Placeholder for ${shot.id}. ${shot.alt}`}>
        <span class="shot-ph__id">{shot.id} · Placeholder</span>
        <span class="shot-ph__state">{shot.state}</span>
      </div>
    )
  }
</div>
