---
import "../styles/tokens.css";
import "../styles/bundle.css";
import "../styles/site.css";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Placeholder pages stay out of search results until their copy is final. */
  noindex?: boolean;
  /** Social card, 1200 x 630 under public/og/. Pages without their own use the home card. */
  ogImage?: { path: string; alt: string };
}
const {
  title = site.title,
  description = site.description,
  noindex = false,
  ogImage = { path: "/og/home.png", alt: site.ogImageAlt },
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
const ogImageUrl = new URL(ogImage.path, site.siteUrl).toString();

// Structured data for the home page only. No rating or review: there are none to cite.
const softwareApplication =
  Astro.url.pathname === "/"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: site.productName,
        operatingSystem: "macOS 14 or later",
        applicationCategory: "MultimediaApplication",
        softwareVersion: site.softwareVersion,
        offers: { "@type": "Offer", price: "59", priceCurrency: "EUR" },
        author: { "@type": "Person", name: site.owner },
      })
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#131415" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.productName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Inter is self-hosted (site.css): the site makes no third-party request. -->
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    {softwareApplication && <script is:inline type="application/ld+json" set:html={softwareApplication} />}
    <script is:inline>
      // Increase contrast: the design system's second theme.
      (function () {
        var m = window.matchMedia("(prefers-contrast: more)");
        function apply() {
          if (m.matches) document.documentElement.setAttribute("data-theme", "contrast");
          else document.documentElement.removeAttribute("data-theme");
        }
        apply();
        if (m.addEventListener) m.addEventListener("change", apply);
      })();
      // "js" means scripts run; "motion" means they run and the visitor allows animation. Every
      // hidden-before-reveal state in site.css is gated behind "motion", so without JavaScript or
      // with reduced motion the whole page is visible at once.
      (function () {
        var root = document.documentElement;
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
        root.classList.add("js");
        if (!reduce.matches) root.classList.add("motion");
      })();
    </script>
  </head>
  <body class="sl-page">
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      // Scroll reveal: fade up once as an element enters. Items above the viewport (a reload part-way
      // down, an anchor jump) are shown at once. Without motion or without IntersectionObserver
      // nothing is ever hidden.
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains("motion")) return;
        var reveals = document.querySelectorAll("[data-reveal]");
        var show = function (el) { el.classList.add("is-in"); };
        if (!("IntersectionObserver" in window)) {
          Array.prototype.forEach.call(reveals, show);
          return;
        }
        var revealer = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting || e.boundingClientRect.top < 0) {
              show(e.target);
              revealer.unobserve(e.target);
            }
          });
        }, { rootMargin: "0px 0px -8% 0px" });
        Array.prototype.forEach.call(reveals, function (el) { revealer.observe(el); });
      })();
    </script>
  </body>
</html>
