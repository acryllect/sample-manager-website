---
import DocPage from "../components/DocPage.astro";
import DocSection from "../components/DocSection.astro";
import SupportEmail from "../components/SupportEmail.astro";
import { site, text, links, legal, splitOnSupportEmail } from "../config/site";

const { productName } = site;
// Renders a string with each support address as a mailto link.
const withEmail = (value: string) => splitOnSupportEmail(value).map((part) => (part === text.supportEmail ? { email: true } : { text: part }));
---

<DocPage title="Founding beta terms" path="/terms/">
  <Fragment slot="lead">What you get for your founding-beta purchase, and the terms it's sold under.</Fragment>

  <DocSection id="what-youre-buying" title="What you're buying">
    <ul>
      <li>€59, paid once. Not a subscription.</li>
      <li>Private access to the founding beta, direct support from the founder, beta fixes and updates delivered manually, and the v1 release when it ships.</li>
      <li>The founding price, regardless of the later public price.</li>
    </ul>
  </DocSection>

  <DocSection id="pre-release-software" title="Pre-release software">
    <p class="doc__notice">
      {productName} is pre-release software. The core library, analysis, search, audition, organisation, and discovery workflows are functional, but you may encounter defects. Updates may require downloading a new build manually. Initial support is Apple silicon on macOS 14+. Review the <a href={links.knownIssues}>known issues</a>, refund policy, <a href={links.supportedSetup}>system requirements</a>, and purchase terms before paying.
    </p>
  </DocSection>

  <DocSection id="the-v1-release" title="The v1 release">
    <p>{text.foundingEntitlement}</p>
  </DocSection>

  <DocSection id="payment" title="Payment">
    <p>Payment is processed by {text.paymentProvider}, my merchant of record. {text.paymentProvider} sells the licence, takes the payment, handles VAT and sends your receipt.</p>
  </DocSection>

  <DocSection id="refunds" title="Refunds">
    <p>{withEmail(text.refundPolicy).map((p) => ("email" in p ? <SupportEmail /> : p.text))}</p>
  </DocSection>

  <DocSection id="terms-of-use" title="Terms of use, warranty and liability">
    {legal.terms.map((p) => <p><strong>{p.lead}</strong> {p.body}</p>)}
  </DocSection>

  <DocSection id="seller" title="Seller">
    <p>{withEmail(text.sellerDetails).map((p) => ("email" in p ? <SupportEmail /> : p.text))}</p>
  </DocSection>
</DocPage>
