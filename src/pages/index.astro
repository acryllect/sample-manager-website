---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import WorkflowStep from "../components/WorkflowStep.astro";
import TrustSection from "../components/TrustSection.astro";
import Founder from "../components/Founder.astro";
import BetaOffer from "../components/BetaOffer.astro";
import FitSection from "../components/FitSection.astro";
import FAQ from "../components/FAQ.astro";
import ScreenshotFrame from "../components/ScreenshotFrame.astro";
import { siteConfig } from "../config/site";

const applicationSteps = [
  "Apply.",
  "I check that the current beta supports your setup.",
  "If it does, I'll send you the checkout and build.",
  "Use it on your actual library and tell me where it helps or gets in the way.",
];

const faqItems = [
  {
    q: "Why is the beta paid?",
    a: "<p>Because I want to build this around people who have the problem badly enough to actually use it in real work. The beta is deliberately small, and paying customers get the current app, beta updates, the eventual v1 release, and direct support from me.</p>",
  },
  {
    q: `Is ${siteConfig.foundingPrice} a subscription?`,
    a: `<p>No. It's a one-time payment for the founding beta. See <a href="/terms">terms</a>.</p>`,
  },
  {
    q: "Will I need a license key?",
    a: "<p>Not right now — I handle access and delivery directly while the beta is small.</p>",
  },
  {
    q: "Does it move my samples?",
    a: '<p>No. The beta uses Reference Library mode, which indexes your files where they already live. See the <a href="/support">support hub</a> for details.</p>',
  },
  {
    q: "How do updates work?",
    a: "<p>I send you a new build directly when one's ready, along with notes on what changed. Automatic updates aren't built yet.</p>",
  },
  {
    q: "What if it doesn't work for my setup?",
    a: '<p>Check the <a href="/refunds">refund policy</a>, <a href="/known-issues">known issues</a>, and <a href="/system-requirements">system requirements</a> before you apply. If something\'s blocking installation or the core workflow, email me at <a href="mailto:' +
      siteConfig.supportEmail +
      '">' +
      siteConfig.supportEmail +
      "</a>.</p>",
  },
];
---

<BaseLayout
  title={`${siteConfig.productName} founding beta — Find the sounds you already own`}
  description={`Apply for a small ${siteConfig.foundingPrice} paid beta of a private Mac sample library for producers, sound designers, and composers with substantial local libraries.`}
>
  <Hero />

  <section class="section section--tight" id="proof">
    <div class="container">
      <ScreenshotFrame
        id="S01"
        caption="Search results for “dark metallic impact” — waveform visible, mixed locations."
      />
    </div>
  </section>

  <section class="section" id="problem">
    <div class="container-narrow" style="text-align:center;">
      <h2>Your library is bigger than your memory.</h2>
      <p class="lede" style="margin-inline:auto;">
        You remember the sound — dark, metallic, short — but not whether it
        came from a pack you bought last year, a folder on an SSD, or a
        session from three projects ago. {siteConfig.productName} is meant to
        make the filename and folder structure matter less.
      </p>
    </div>
  </section>

  <section class="section" id="product">
    <div class="container">
      <div class="section-heading">
        <h2>Search, then follow the thread.</h2>
      </div>

      <WorkflowStep number={1} title="Search what you remember">
        <p>
          Try a phrase such as <code>dark metallic impact</code>. Search is
          fuzzy and typo-tolerant, so rough wording still gets you there —
          narrow with filters when you already know what you're after.
        </p>
        <div>
          <span class="chip">bpm:118-124</span>
          <span class="chip">key:Amin</span>
          <span class="chip">type:loop</span>
        </div>
        <Fragment slot="media">
          <ScreenshotFrame
            id="S02"
            caption="bpm:118-124 key:Amin type:loop — rendered as chips, results narrowed."
          />
        </Fragment>
      </WorkflowStep>

      <WorkflowStep number={2} title="Find Similar" reverse>
        <p>
          Found something close but not quite right? Pick it, and{" "}
          {siteConfig.productName} surfaces similar sounds across your whole
          library — not just the folder it came from.
        </p>
        <Fragment slot="media">
          <ScreenshotFrame
            id="S04"
            caption="A source sound and its closest matches."
          />
        </Fragment>
      </WorkflowStep>

      <WorkflowStep number={3} title="Explore the Sonic Map">
        <p>
          Browse your library visually — related sounds cluster together.
          Refine with a thumbs up or down, then lasso the ones worth keeping
          into a shortlist.
        </p>
        <Fragment slot="media">
          <ScreenshotFrame
            id="S03"
            caption="Sonic Map — clusters, a selected point, and a shortlist."
          />
        </Fragment>
      </WorkflowStep>
    </div>
  </section>

  <TrustSection />

  <section class="section capability-line">
    <div class="container-narrow" style="text-align:center;">
      <p class="capability-list mono">
        Search &middot; Find Similar &middot; Sonic Map &middot; BPM/key/type
        analysis &middot; waveform audition &middot; crates &middot; duplicate
        review
      </p>
    </div>
  </section>

  <Founder />

  <BetaOffer />

  <FitSection />

  <section class="section section--tight" id="process">
    <div class="container-narrow">
      <div class="section-heading">
        <h2>How joining works</h2>
      </div>
      <ol class="process-list">
        {applicationSteps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="process-note">
        Applying does not commit you to purchase. I'll check in with you
        after you've used it.
      </p>
      <a href="/apply" class="btn btn-primary">Apply for the founding beta</a>
    </div>
  </section>

  <FAQ items={faqItems} />
</BaseLayout>

<style>
  .capability-line {
    padding-block: var(--space-8);
  }

  .capability-list {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .process-list {
    counter-reset: step;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .process-list li {
    counter-increment: step;
    position: relative;
    padding-left: 2.5rem;
    font-size: 0.9375rem;
  }

  .process-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.1rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--bg-elevated-2);
    border: 1px solid var(--border);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .process-note {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }
</style>
