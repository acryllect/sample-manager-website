---
/** One H2 section of a doc page. DocPage builds the "On this page" list from these headings. */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="doc__section" aria-labelledby={id} data-reveal>
  <h2 class="doc__h2" id={id}>{title}</h2>
  <slot />
</section>
