---
/**
 * ScreenshotFrame window. Shows the real capture when shot.src is set, otherwise a labelled
 * placeholder. Never a mock of the app. Only the hero shot passes `eager`; the rest lazy-load.
 */
import type { Shot } from "../data/shots";

interface Props {
  shot: Shot;
  eager?: boolean;
}
const { shot, eager = false } = Astro.props;
---

<div class="sl-shot__window" data-window={shot.id}>
  {
    shot.src ? (
      <img
        src={shot.src}
        alt={shot.alt}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
        width="2400"
        height="1500"
      />
    ) : (
      <div class="shot-ph" role="img" aria-label={`Placeholder for ${shot.id}. ${shot.alt}`}>
        <span class="shot-ph__id">{shot.id} · Placeholder</span>
        <span class="shot-ph__state">{shot.state}</span>
      </div>
    )
  }
</div>
