---
import "../styles/tokens.css";
import "../styles/bundle.css";
import "../styles/site.css";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Placeholder pages stay out of search results until their copy is final. */
  noindex?: boolean;
}
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#131415" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.productName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <!-- Inter is the site's only external request. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..600&display=swap" />
    <script is:inline>
      // Increase contrast: the design system's second theme.
      (function () {
        var m = window.matchMedia("(prefers-contrast: more)");
        function apply() {
          if (m.matches) document.documentElement.setAttribute("data-theme", "contrast");
          else document.documentElement.removeAttribute("data-theme");
        }
        apply();
        if (m.addEventListener) m.addEventListener("change", apply);
      })();
    </script>
    <noscript>
      <style>
        .thumbs { display: none; }
        .tabs { display: none; }
        [role="tabpanel"][hidden] { display: block; }
      </style>
    </noscript>
  </head>
  <body class="sl-page">
    <slot />
  </body>
</html>
