---
import { siteConfig } from "../config/site";
---

<section class="fit section section--tight" id="fit">
  <div class="container-narrow">
    <h2>This beta is probably for you if&hellip;</h2>
    <p class="lede">
      You make music, compose, or design sound on a Mac, have thousands of
      samples spread across folders or drives, and regularly know what kind
      of sound you want without remembering where it lives.
    </p>
    <p class="fit-technical">
      The current beta requires {siteConfig.supportedArchitecture},{" "}
      {siteConfig.supportedMacOS}, and uses Reference Library mode.
    </p>
    <p class="fit-technical">
      If you need Windows, Intel, cloud sync, or Managed Library mode,{" "}
      {siteConfig.productName} isn't ready for your setup yet.
    </p>
  </div>
</section>

<style>
  .fit-technical {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 56ch;
  }
</style>
