---
import LegalLayout from "../layouts/LegalLayout.astro";
import ConfigNotice from "../components/ConfigNotice.astro";
import { siteConfig } from "../config/site";
---

<LegalLayout
  title="Refund Policy"
  description={`Refund policy for the ${siteConfig.productName} founding beta — final copy pending legal review.`}
>
  <ConfigNotice title="TODO: FINAL LEGAL COPY" kind="legal">
    <p>
      This page is a placeholder. No refund policy has been approved yet.
      Accepted applicants will see the confirmed policy before checkout, and
      this page will be updated to match exactly.
    </p>
  </ConfigNotice>

  <h2>What this policy will cover</h2>
  <ul>
    <li>The refund window and how to request a refund</li>
    <li>What happens to founding-beta access after a refund</li>
    <li>How the policy interacts with EU/international consumer-rights rules for digital content</li>
  </ul>

  <h2>Working position (not yet approved)</h2>
  <p>
    A commercially generous refund window is under consideration for the
    founding beta, to be finalized against the actual Merchant-of-Record
    terms and applicable consumer law before it is published as policy. No
    specific number is confirmed yet — do not treat this paragraph as a
    binding commitment.
  </p>

  <h2>Contact</h2>
  <p>
    Questions before this policy is finalized: {" "}
    <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
  </p>
</LegalLayout>
