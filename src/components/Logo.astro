---
import { siteConfig } from "../config/site";

interface Props {
  /** Mark size in pixels */
  size?: number;
  /** Show the wordmark text next to the mark */
  withWordmark?: boolean;
  class?: string;
}

const { size = 28, withWordmark = true, class: className = "" } = Astro.props;

// Unique per render so multiple Logo instances on one page (header + footer)
// don't collide on the gradient id.
const gradientId = `logo-glow-${Math.random().toString(36).slice(2, 9)}`;
---

<span class:list={["logo", className]}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    role="img"
    aria-label={`${siteConfig.productName} mark`}
  >
    <defs>
      <radialGradient id={gradientId} cx="50%" cy="46%" r="60%">
        <stop offset="0%" stop-color="#f2b656" stop-opacity="0.95"></stop>
        <stop offset="55%" stop-color="#e8a33d" stop-opacity="0.35"></stop>
        <stop offset="100%" stop-color="#e8a33d" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect
      x="2.5"
      y="2.5"
      width="27"
      height="27"
      rx="8.5"
      stroke="#4a4438"
      stroke-width="1.4"></rect>
    <circle cx="16" cy="16" r="10" fill={`url(#${gradientId})`}></circle>
    <circle cx="16" cy="16" r="3.25" fill="#f2b656"></circle>
  </svg>
  {withWordmark && <span class="logo-word">{siteConfig.productName}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  .logo-word {
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
