---
import { siteConfig } from "../config/site";

const included = [
  `The current ${siteConfig.productName} beta`,
  "Every beta update",
  "The eventual v1 release",
  `Direct support from ${siteConfig.founderFirstName}`,
  "The founding price, even if the public price rises later",
];
---

<section class="offer section" id="offer">
  <div class="container-narrow">
    <div class="section-heading" style="margin-inline:auto; text-align:center;">
      <h2>Join the founding beta for {siteConfig.foundingPrice}.</h2>
      <p class="lede" style="margin-inline:auto;">One payment. No subscription.</p>
    </div>

    <div class="offer-card card">
      <div class="offer-price">
        <span class="price-amount">{siteConfig.foundingPrice}</span>
        <span class="price-detail">once &middot; no subscription</span>
      </div>

      <ul class="offer-list">
        {included.map((item) => <li>{item}</li>)}
      </ul>

      <p class="offer-note">
        This is real, working software, but it's still a beta. You may hit
        bugs. In return, you'll be using it early and talking directly to me
        while I finish v1.
      </p>

      <a href="/apply" class="btn btn-primary btn-block">Apply for the founding beta</a>

      <p class="offer-disclosure">
        Review the <a href="/known-issues">known issues</a>, <a href="/refunds">refund policy</a>,
        and <a href="/system-requirements">system requirements</a> before applying.
      </p>
    </div>
  </div>
</section>

<style>
  .offer-card {
    text-align: center;
  }

  .offer-price {
    margin-bottom: var(--space-6);
  }

  .price-amount {
    display: block;
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .price-detail {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  .offer-list {
    list-style: none;
    padding: 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .offer-list li {
    position: relative;
    padding-left: 1.5em;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .offer-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .offer-note {
    font-size: 0.875rem;
    margin-bottom: var(--space-6);
  }

  .offer-disclosure {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: var(--space-6);
    margin-bottom: 0;
    text-align: center;
    max-width: none;
  }
</style>
