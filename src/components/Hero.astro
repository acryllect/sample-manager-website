---
import { siteConfig } from "../config/site";

// Deterministic pseudo-random bar heights for the waveform art (no client JS).
const bars = Array.from({ length: 64 }).map((_, i) => {
  const h = 12 + Math.abs(Math.sin(i * 0.7) * 40) + Math.abs(Math.cos(i * 0.35) * 20);
  return Math.min(92, Math.round(h));
});
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Founding beta &middot; {siteConfig.foundingPrice} once</p>
      <h1>{siteConfig.tagline}</h1>
      <p class="lede">
        {siteConfig.productName} turns scattered sample packs, folders, and drives
        into one searchable library on your Mac — without uploading your sounds.
      </p>

      <div class="hero-actions">
        <a href="/apply" class="btn btn-primary">Apply for the founding beta</a>
        <a href="/demo" class="btn btn-secondary">Watch the 75-second demo</a>
      </div>

      <p class="hero-trust">
        No subscription &middot; No mandatory account &middot; No sample uploads
      </p>
      <p class="hero-requirements mono">
        {siteConfig.supportedArchitecture} &middot; {siteConfig.supportedMacOS} &middot; Reference Library mode
      </p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 480 240" preserveAspectRatio="none" role="presentation">
        <defs>
          <linearGradient id="hero-fade" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#3a3528" />
            <stop offset="55%" stop-color="#e8a33d" />
            <stop offset="100%" stop-color="#f6c877" />
          </linearGradient>
          <radialGradient id="hero-beam" cx="78%" cy="45%" r="65%">
            <stop offset="0%" stop-color="rgba(242,182,86,0.32)" />
            <stop offset="100%" stop-color="rgba(242,182,86,0)" />
          </radialGradient>
        </defs>
        <rect x="0" y="0" width="480" height="240" fill="url(#hero-beam)" />
        {
          bars.map((h, i) => {
            const x = i * (480 / bars.length) + 2;
            const barH = (h / 100) * 200;
            const y = 120 - barH / 2;
            return (
              <rect
                x={x}
                y={y}
                width={480 / bars.length - 2}
                height={barH}
                rx="1.5"
                fill="url(#hero-fade)"
                opacity={0.35 + (i / bars.length) * 0.65}
              />
            );
          })
        }
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero h1 {
    max-width: 14ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-block: var(--space-6);
  }

  .hero-trust {
    font-size: 0.9375rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .hero-requirements {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .hero-art {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
  }

  .hero-art svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero h1 {
      max-width: none;
    }
  }
</style>
